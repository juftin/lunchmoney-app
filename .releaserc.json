{
    "branches": [
        "main",
        "master",
        "next",
        "next-major",
        "+([0-9])?(.{+([0-9]),x}).x",
        {
            "name": "beta",
            "prerelease": true
        },
        {
            "name": "alpha",
            "prerelease": true
        }
    ],
    "plugins": [
        "semantic-release-gitmoji",
        [
            "@semantic-release/exec",
            {
                "prepareCmd": "uv version ${nextRelease.version} && python3 scripts/sync_bundle_versions.py ${nextRelease.version} && task dist && task mcpb && task registry:manifest VERSION=${nextRelease.version} MCPB=dist/lunchmoney-app.mcpb MCPB_URL=https://github.com/juftin/lunchmoney-app/releases/download/${nextRelease.gitTag}/lunchmoney-app.mcpb OUTPUT=dist/mcp-registry/server.json"
            }
        ],
        [
            "@semantic-release/git",
            {
                "assets": [
                    "pyproject.toml",
                    "uv.lock",
                    ".agents/plugins/marketplace.json",
                    ".claude-plugin/marketplace.json",
                    "gemini-extension.json",
                    "mcp-registry/server.json",
                    "mcpb/manifest.json",
                    "plugins/lunchmoney-mcp/.claude-plugin/plugin.json",
                    "plugins/lunchmoney-mcp/.codex-plugin/plugin.json"
                ],
                "message": "🔖 lunchmoney-app ${nextRelease.version}\n\n${nextRelease.notes}\n[skip ci]"
            }
        ],
        [
            "@semantic-release/github",
            {
                "assets": [
                    {
                        "path": "dist/*.whl"
                    },
                    {
                        "path": "dist/*.tar.gz"
                    },
                    {
                        "path": "dist/lunchmoney-app.mcpb"
                    },
                    {
                        "path": "dist/mcp-registry/server.json"
                    }
                ]
            }
        ],
        [
            "@semantic-release/exec",
            {
                "publishCmd": "curl --fail --location https://github.com/modelcontextprotocol/registry/releases/latest/download/mcp-publisher_$(uname -s | tr '[:upper:]' '[:lower:]')_$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/').tar.gz | tar xz mcp-publisher && ./mcp-publisher login github-oidc && ./mcp-publisher publish dist/mcp-registry/server.json"
            }
        ]
    ]
}
